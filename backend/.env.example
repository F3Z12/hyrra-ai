# ─────────────────────────────────────────────────────────────────────────────
# Hyrra AI backend — environment variables example
# Copy this file to .env and fill in your real values.
# .env is gitignored and never committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── OpenClaw runner (dev/local only — NEVER enable in production) ─────────────

# Set to true to enable the local OpenClaw subprocess runner.
ENABLE_LOCAL_OPENCLAW_RUNNER=false

# Hard cap on OpenClaw subprocess duration in seconds (default: 600).
OPENCLAW_MAX_TIMEOUT=600

# Full path to the OpenClaw binary.
# On Windows: find with  where.exe openclaw  (pick the .cmd variant)
# On Mac/Linux: find with  which openclaw
OPENCLAW_BIN=/path/to/openclaw  # Windows example: C:\Users\<you>\AppData\Roaming\npm\openclaw.cmd

# Full path to the Codex app-server binary used internally by OpenClaw.
# The Python subprocess may not inherit this variable from your shell.
# Find it inside the OpenClaw npm package installation directory.
# Windows example: C:\Users\<you>\.openclaw\npm\node_modules\@openai\codex-win32-x64\vendor\x86_64-pc-windows-msvc\codex\codex.exe
OPENCLAW_CODEX_APP_SERVER_BIN=/path/to/codex
